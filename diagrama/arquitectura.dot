digraph G {
  graph [rankdir=TB, fontname="Arial", bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.6, newrank=true,
         label="GRUPO 01 · LG15 · Arquitectura HDFS: 1 NameNode + 3 DataNodes, factor de replicación 2", labelloc=t, fontsize=18];
  node [fontname="Arial", fontsize=12, shape=box, style="rounded,filled", color="#5b6b7a", penwidth=1.2];
  edge [fontname="Arial", fontsize=10, color="#5b6b7a"];

  pc [label="PC Windows · Docker Desktop\nPowerShell (docker compose) y navegador (localhost:9870)", fillcolor="#eef1f4"];

  subgraph cluster_docker {
    label="Red Docker  hadoop-sandbox_default"; fontsize=13; style="rounded,dashed"; color="#8a97a3"; labeljust=l;
    client [label="clientnode\ncliente HDFS + script lg15.sh\n(carga datasets, fsck, monitoreo)", fillcolor="#fff4d6"];
    front  [label="front (Apache httpd)\nproxy de las interfaces web", fillcolor="#f2f2f2"];
    nn [label="NameNode  ·  namenode:8020\nmetadatos: archivo → bloques → DataNodes\nrecibe latidos, detecta fallas y ordena la re-replicación", fillcolor="#dbe9fb", penwidth=2];
    dn1 [label="DN1 · hadoopnode\n+ NodeManager (YARN)\nvolumen hadoopnode", fillcolor="#e3f4ea"];
    dn2 [label="DN2 · hadoopnode2\nvolumen hadoopnode2\n✖ nodo detenido en las pruebas", fillcolor="#fbe3e3", color="#c0392b", penwidth=2];
    dn3 [label="DN3 · hadoopnode3\nvolumen hadoopnode3", fillcolor="#e3f4ea"];
    nota [shape=note, style=filled, fillcolor="#eaf2fc", color="#2a78d6", fontcolor="#1d4f8c",
          label="Datasets: dataset_grupo01_1GB (8 bloques) y dataset_grupo01_10GB (80 bloques)\nCada bloque de 128 MB se guarda en 2 DataNodes distintos.\nSi DN2 cae, el NameNode ordena a DN1 y DN3 copiar los bloques que quedaron con 1 sola réplica."];
  }

  pc -> client [label=" docker compose exec"];
  pc -> front  [label=" 9870 / 8080"];
  client -> nn [label=" ¿dónde están los bloques?"];
  front -> nn  [style=dashed];
  nn -> dn1 [dir=back, style=dotted, label=" latidos c/3 s\n + reporte de bloques"];
  nn -> dn2 [dir=back, style=dotted];
  nn -> dn3 [dir=back, style=dotted];
  dn1 -> nota [style=invis]; dn2 -> nota [style=invis]; dn3 -> nota [style=invis];
  { rank=same; client; front; }
  { rank=same; dn1; dn2; dn3; }
}
